[Unit]
Description=MITRPHOL AMD64 X11 Kiosk Display Service
After=systemd-user-sessions.service pid-app.service
# Wait for GPU driver (i915/amdgpu) to initialize before X11 starts
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
User=root
WorkingDirectory=/root
ExecStart=/usr/bin/xinit /root/.xinitrc -- /usr/bin/X -nolisten tcp
Restart=on-failure
RestartSec=5
RestartKillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=graphical.target